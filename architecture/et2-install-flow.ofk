flow: et2 — Plugin install flow
direction: LR

[start] start: Operator starts
[process] run: Run install-plugin.sh
  { icon: "Terminal", color: "blue" }
[process] detect: Detect host (Cursor / Claude / Kimi)
  { icon: "Search", color: "amber" }
[process] config: Write MCP config + copy skill
  { icon: "Settings", color: "violet" }
[process] preflight: Preflight toolchain checks
  { icon: "CheckCircle", color: "emerald" }
[end] ready: Plugin ready

start ==> run
run ==> detect
detect ==> config
config ==> preflight
preflight ==> ready
