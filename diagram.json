{
  "version": 1,
  "author": "Demo Bot",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s3-box", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-rgb-led", "id": "rgb", "top": -60, "left": 180, "attrs": {} },
    { "type": "wokwi-resistor", "id": "r1", "top": -30, "left": 140, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 10, "left": 140, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:2", "r1:1", "red", [ "h0" ] ],
    [ "r1:2", "rgb:R", "red", [ "h0" ] ],
    [ "esp:3", "r2:1", "green", [ "h0" ] ],
    [ "r2:2", "rgb:G", "green", [ "h0" ] ],
    [ "rgb:COM", "esp:GND.1", "black", [ "h0" ] ]
  ]
}
